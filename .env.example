# ---------------------------------------------------------------------------
# Copy this file to .env before the first `docker compose up`:
#     cp .env.example .env
# .env is git-ignored. Nothing here reaches the public internet at runtime
# except the one-time model pull.
# ---------------------------------------------------------------------------

# --- Ollama ----------------------------------------------------------------
# Pin the image for reproducibility. Bump deliberately, not accidentally.
OLLAMA_IMAGE=ollama/ollama:0.9.0

# The app talks to Ollama over the compose network by SERVICE NAME.
# It is NOT localhost: inside the app container, localhost is the app itself.
OLLAMA_URL=http://ollama:11434

# Pulled once into the ollama_models named volume, then reused offline forever.
# ~4.7 GB download. Smaller CPU-friendly alternative: qwen2.5-coder:1.5b
OLLAMA_MODEL=qwen2.5-coder:7b

# Seconds to wait for a single generation. CPU inference on a 7B model is slow;
# 180 s is deliberately generous. Lower it if you switch to a small model.
OLLAMA_TIMEOUT=180

# --- Database: shared connection target ------------------------------------
POSTGRES_DB=mfg
DB_HOST=db
DB_PORT=5432

# --- Database role 1: ADMIN. Used ONLY by the one-shot `seed` service. ------
# Creates tables, inserts data, grants SELECT to the readonly role.
POSTGRES_ADMIN_USER=mfg_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# --- Database role 2: READONLY. Used by the chatbot query path. -------------
# SELECT-only, granted by the seed step. The chatbot is physically incapable
# of writing because this is the only connection its query path ever opens.
APP_READONLY_USER=readonly_user
APP_READONLY_PASSWORD=change-me-readonly

# The connection strings are BUILT from the variables above — the same ones the
# db container uses to create the roles — so a password can never be right in
# one place and wrong in another. Change a password here and it changes for
# both the role and the app.
#
# Changing a password here is enough: the seed step re-applies it to the role on
# every bring-up, so no volume surgery is needed. (db/init/ only ever runs
# against an EMPTY data volume, which is why the seed step owns this too.)
#
# If you ever do need to reset the database, remove ITS volume by name — plain
# `docker compose down -v` also deletes the model volume and costs you the
# whole ~4.7 GB download again:
#     docker compose down && docker volume rm mfg_pgdata && docker compose up
#
# Optional escape hatch: set these ONLY to point at a database this compose file
# did not create (an existing server, a different host). If set, they must agree
# with the variables above or the app refuses to start with a clear message.
# ADMIN_DATABASE_URL=postgresql://mfg_admin:change-me-admin@db:5432/mfg
# READONLY_DATABASE_URL=postgresql://readonly_user:change-me-readonly@db:5432/mfg

# --- SQL safety guardrails -------------------------------------------------
# Hard cap on rows returned; the guard injects/clamps LIMIT to this.
MAX_ROWS=200
# Server-side statement timeout for the readonly connection (milliseconds).
STATEMENT_TIMEOUT_MS=8000

# --- Seed data -------------------------------------------------------------
# Fixed RNG seed: identical data pattern on every machine.
SEED_RANDOM_SEED=20260101
SEED_DAYS=60
# Leave blank to anchor the 60-day window to *today*, so demo questions like
# "yesterday" and "last week" always have data. Set an ISO date
# (e.g. 2026-08-24) to pin the calendar too, for byte-identical rows.
SEED_END_DATE=

# --- Ports on the host ------------------------------------------------------
APP_PORT=8000
DB_PORT_HOST=5432
OLLAMA_PORT_HOST=11434

# --- Dialect ---------------------------------------------------------------
# 'postgres' today. See README "Migrating to SQL Server" before changing.
DB_DIALECT=postgres
